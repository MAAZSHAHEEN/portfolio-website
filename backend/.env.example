# General
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Anthropic (AI "Ask about Maaz" chat) - Phase 3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Contact form - Option A: SMTP - Phase 3
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Contact form - Option B: Resend (alternative to SMTP) - Phase 3
RESEND_API_KEY=

# Contact form - destination/sender addresses - Phase 3
CONTACT_TO_EMAIL=maazshaheen5566@gmail.com
CONTACT_FROM_EMAIL=no-reply@portfolio.local

# Rate limiting - Phase 3
RATE_LIMIT_CONTACT=5/hour
RATE_LIMIT_CHAT=20/hour
